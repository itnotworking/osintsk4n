{
  "manifest_version": 3,
  "name": "SC4N Threat Lookup",
  "version": "1.0.0",
  "description": "Check a link, domain, IP, email, phone number or file hash for threats. Right-click or paste for a plain-English verdict.",
  "homepage_url": "https://sc4n.lol",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "activeTab"],
  "host_permissions": ["https://sc4n.lol/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SC4N Threat Lookup",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
